omit-lockfile-registry-resolved=true

# Because the lockfile has no `resolved` URLs (see above), npm must fetch a full
# packument for every dependency. Corporate proxies that strip ETag/Last-Modified
# and return `Cache-Control: no-cache` make those fetches uncacheable, so installs
# re-download hundreds of MB of metadata and appear to hang. Prefer the local cache.
prefer-offline=true
