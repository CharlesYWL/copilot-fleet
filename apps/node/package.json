{
  "name": "@fleet/node",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "copilot-fleet-node": "./dist/main.js"
  },
  "scripts": {
    "dev": "node supervisor.mjs --dev",
    "dev:watch": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node supervisor.mjs",
    "start:bare": "node dist/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@fleet/protocol": "0.2.0",
    "dotenv": "^17.2.2",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  }
}
