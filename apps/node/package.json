{
  "name": "@fleet/node",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "bin": {
    "copilot-fleet-node": "./dist/main.js"
  },
  "scripts": {
    "dev": "vite build && node supervisor.mjs --dev",
    "dev:watch": "vite build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node supervisor.mjs",
    "start:bare": "node dist/main.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@fleet/protocol": "0.8.1",
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.334",
    "dotenv": "^17.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.15",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "vite": "^7.1.5"
  }
}
