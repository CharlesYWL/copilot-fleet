{
  "name": "@fleet/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@fleet/protocol": "0.1.0",
    "@fluentui/react-components": "^9.74.5",
    "@fluentui/react-icons": "^2.0.334",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "vite": "^7.1.5"
  }
}
