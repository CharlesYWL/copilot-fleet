# Loopback only. Set 0.0.0.0 to accept nodes from other machines, and pair it
# with a real ENROLLMENT_TOKEN before doing so.
HOST=127.0.0.1
PORT=8787
# The password for the fleet's web UI and API. Anyone who signs in can start
# processes on every enrolled machine, so treat it as a root password. Leave it
# unset and the Host generates one on first boot and prints it to its console.
# FLEET_OPERATOR_PASSWORD=change-me
# Extra names the Host answers to, comma-separated. Loopback, FLEET_PUBLIC_URL
# and the live tunnel URL are always accepted; add a name here when you reach
# the Host through a reverse proxy or a LAN hostname. "*" turns the check off,
# which also turns off the protection against DNS rebinding.
# FLEET_ALLOWED_HOSTS=fleet.lan,10.0.0.5
# The address remote nodes dial; shown in the UI's connect command. Leave unset
# for local-only use, set it to your tunnel or LAN address otherwise.
# FLEET_PUBLIC_URL=https://fleet.example.com
DATABASE_PATH=./apps/host/data/fleet.db
ENROLLMENT_TOKEN=change-me
# How long an agent waits for a human decision before giving up and denying.
PERMISSION_TIMEOUT_MS=1800000

# Node service
# Every variable below can also be passed as a flag, which wins over this file
# and over the node's saved settings.json:
#   npm run start:node -- --url=https://fleet.example.com --token=... --help
FLEET_HOST_URL=http://127.0.0.1:8787
FLEET_ENROLLMENT_TOKEN=change-me
# Defaults to the machine hostname; rename later from the Host's Nodes tab.
# FLEET_NODE_NAME=workstation-1
FLEET_MAX_SESSIONS=4
# Context window Copilot sessions are started with: default | long_context.
# The long window is a setting on a model, not a model of its own: Copilot's
# catalog puts claude-opus-5, claude-sonnet-5 and Gemini at 1,000,000 tokens and
# GPT-5.6 at 1,050,000, under the ids the picker already shows. Which tier a
# model runs on is otherwise persisted per model in the app's store and only
# covers models switched over by hand, so asking here is what keeps every node
# the same. Ignored if this machine's Copilot predates --context.
# Note: /context reports 264k in ACP mode even for 1,000,000-token models. That
# number is not the enforced budget — a 435k-token prompt goes through.
FLEET_CONTEXT_TIER=long_context
# Set to 1 for the deterministic no-login demo adapter.
FLEET_MOCK_AGENT=0
# Set to 1 for Copilot YOLO mode (--allow-all: tools + paths + urls, no prompts).
# FLEET_ALLOW_ALL=1 and the older FLEET_ALLOW_ALL_TOOLS=1 are synonyms.
FLEET_YOLO=0
