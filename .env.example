# Loopback only. Set 0.0.0.0 to accept nodes from other machines, and pair it
# with a real ENROLLMENT_TOKEN before doing so.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./apps/host/data/fleet.db
ENROLLMENT_TOKEN=change-me
# How long an agent waits for a human decision before giving up and denying.
PERMISSION_TIMEOUT_MS=1800000

# Node service
FLEET_HOST_URL=http://127.0.0.1:8787
FLEET_ENROLLMENT_TOKEN=change-me
FLEET_NODE_NAME=workstation-1
FLEET_MAX_SESSIONS=4
# Set to 1 for the deterministic no-login demo adapter.
FLEET_MOCK_AGENT=0
# Set to 1 to let Copilot run every tool unattended; skips the approval UI entirely.
FLEET_ALLOW_ALL_TOOLS=0
