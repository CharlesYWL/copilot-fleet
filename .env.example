# Loopback only. Set 0.0.0.0 to accept nodes from other machines.
HOST=127.0.0.1
PORT=8787

# --- Who may operate this Fleet -------------------------------------------
# A fresh Host has no administrator and no password. It prints a one-time claim
# code to its own console; claiming it takes that code AND a Microsoft sign-in.
#
# Register a single-tenant public client in your own directory with the reply
# URL http://localhost/api/auth/entra/callback, no client secret, and no API
# permissions. Entra ignores the port on a localhost reply URL, so one
# registration covers every port and every local forward.
#
# Neither value is a secret. Leave them unset and the first-run screen asks for
# them — after the console claim code. Both are the GUIDs Entra shows on the
# app registration's overview; a tenant domain will not work, because the
# identities Microsoft returns carry the directory ID and would never match one.
# FLEET_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# FLEET_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
#
# Migration escape hatch only. A shared password identifies nobody and cannot
# add or remove administrators; setting it opts this Host into accepting one and
# logs a warning. Claim the Host with a Microsoft account and disable it from
# Settings -> Security.
# FLEET_OPERATOR_PASSWORD=change-me

# Extra names the Host answers to, comma-separated. Loopback, FLEET_PUBLIC_URL
# and the live tunnel URL are always accepted; add a name here when you reach
# the Host through a reverse proxy or a LAN hostname. "*" turns the check off,
# which also turns off the protection against DNS rebinding.
# FLEET_ALLOWED_HOSTS=fleet.lan,10.0.0.5
# The address remote nodes dial; shown in the UI's connect command. Leave unset
# for local-only use, set it to your tunnel or LAN address otherwise. It must be
# HTTPS for anyone to sign in over it: Fleet refuses to issue a session on a
# plain-HTTP external endpoint.
# FLEET_PUBLIC_URL=https://fleet.example.com
DATABASE_PATH=./apps/host/data/fleet.db
# Deprecated: the fleet-wide, reusable enrollment credential that predates Node
# keys. New machines use a one-time grant minted from Settings -> Nodes, which
# authorises exactly one Node key for fifteen minutes. Leave it unset: a fresh
# Host needs none, will not persist one, and refuses token registration
# outright. Set it only to keep a Host running while nodes that predate keys are
# still connecting — an upgrade whose stored token went missing mints its own.
# ENROLLMENT_TOKEN=change-me
# How long an agent waits for a human decision before giving up and denying.
PERMISSION_TIMEOUT_MS=1800000

# Node service
# Every variable below can also be passed as a flag, which wins over this file
# and over the node's saved settings.json:
#   npm run start:node -- --url=https://fleet.example.com --help
FLEET_HOST_URL=http://127.0.0.1:8787
# The three values the Host's Connect card prints. The fingerprint is the one
# that matters: a node that has pinned it sends nothing to anything that cannot
# sign for the matching key, so a relay stays a relay.
# FLEET_HOST_ID=
# FLEET_HOST_FINGERPRINT=
# FLEET_ENROLLMENT_GRANT=<grant-id>.<grant-secret>
# Deprecated, for machines that predate Node keys.
# FLEET_ENROLLMENT_TOKEN=change-me
# Defaults to the machine hostname; rename later from the Host's Nodes tab.
# FLEET_NODE_NAME=workstation-1
FLEET_MAX_SESSIONS=10
# Context window Copilot sessions are started with: default | long_context.
# The long window is a setting on a model, not a model of its own: Copilot's
# catalog puts claude-opus-5, claude-sonnet-5 and Gemini at 1,000,000 tokens and
# GPT-5.6 at 1,050,000, under the ids the picker already shows. Which tier a
# model runs on is otherwise persisted per model in the app's store and only
# covers models switched over by hand, so asking here is what keeps every node
# the same. Ignored if this machine's Copilot predates --context.
# Note: /context reports 264k in ACP mode even for 1,000,000-token models. That
# number is not the enforced budget — a 435k-token prompt goes through.
FLEET_CONTEXT_TIER=long_context
# Set to 1 for the deterministic no-login demo adapter.
FLEET_MOCK_AGENT=0
# Set to 1 for Copilot YOLO mode (--allow-all: tools + paths + urls, no prompts).
# FLEET_ALLOW_ALL=1 and the older FLEET_ALLOW_ALL_TOOLS=1 are synonyms.
FLEET_YOLO=0
